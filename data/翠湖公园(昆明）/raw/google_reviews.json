    {
      "reviewId": "ChZDSUhNMG9nS0VJQ0FnSURWNWVISFhBEAE",
      "authorName": "Racharachar",
      "starRating": 5,
      "reviewDate": "2 years ago",
      "localGuideInfo": "Local Guide · 15 reviews",
      "text": "The Green Lake is in the city centre of Kun Ming. The name in Chinese is more befitting of the scenery here - Jade Lake, a good place for couples to scroll along its beautiful pathways lined with elegant trees. Exploring the intricate details of the architecture of the buildings within the park. I can imagine an afternoon spent by the lake reading or writing if I were by myself. There are some touristy things to do too - the children were delighted to feed the migratory Siberian seagulls, chilling at the lake. And of course the obligatory paddle boats on the lake and kiddy rides around the park.",
      "scrapedAt": "2026-03-23T07:20:33.199Z"
    },
